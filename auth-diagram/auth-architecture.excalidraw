  {
   "type": "text",
   "id": "cmp_a",
   "x": 2526,
   "y": 846,
   "text": "Keys (JWKS):  appleid.apple.com/auth/keys\nAlgorithm:    RS256\nclient_secret: ES256 JWT you sign (.p8 key)\nName + email: ONLY on first login!\nScopes:       name email\nCallback:     POST (form_post)",
   "fontSize": 14,
