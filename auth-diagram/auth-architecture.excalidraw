   "lineHeight": 1.25,
   "width": 361,
   "height": 105
  },
  {
   "type": "text",
   "id": "cmp_a_warn",
   "x": 2526,
   "y": 1000,
   "text": "Store name/email immediately \u2014 Apple never\nsends them again. Email may be a private relay.",
   "fontSize": 14,
   "strokeColor": "#b91c1c",
