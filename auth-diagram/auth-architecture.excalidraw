   "originalText": "// decoded id_token payload\n{\n  \"iss\": \"https://appleid.apple.com\",\n  \"aud\": \"com.example.app\",\n  \"sub\": \"001234.ab12cd...0987\",\n  \"email\": \"x7k2@privaterelay.appleid.com\",\n  \"is_private_email\": true,\n  \"email_verified\": true,\n  \"nonce_supported\": true,\n  \"auth_time\": 1767225590,\n  \"exp\": 1767229200\n}",
